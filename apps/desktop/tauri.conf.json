{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AK820 Studio",
  "version": "0.1.0",
  "identifier": "io.github.whattff.Ak820Studio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AK820 Studio",
        "width": 1120,
        "height": 940,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Screen studio for the AJAZZ / Epomaker AK820 Pro keyboard",
    "longDescription": "Put GIFs, images, video, text, drawings and procedural animations on the AK820 Pro's 128x128 screen, and keep its clock in sync automatically.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "publisher": "WhatTFF",
    "homepage": "https://github.com/WhatTFF/linux-ajazz-ak820-pro-app",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
